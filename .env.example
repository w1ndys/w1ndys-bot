# ===== 数据库（必填）=====
DB_HOST=localhost
DB_PORT=5432
DB_USER=w1ndys
DB_PASSWORD=change-me
DB_NAME=w1ndys_bot
# sslmode：disable | require | verify-full（本地与 compose 用 disable）
DB_SSLMODE=disable

# ===== 管理面安全（必填，启动即强制校验）=====
# JWT 签名密钥，至少 32 字节；生成示例：openssl rand -base64 48
JWT_SECRET=
# WebUI 登录密码，至少 12 字符
WEBUI_PASSWORD=
# 超级管理员 QQ 号
SUPER_ADMIN_QQ=

# ===== 服务（可选）=====
# 管理面 / 健康检查监听端口，默认 8080
WEBUI_PORT=8080

# ===== 日志（可选）=====
# debug | info | warn | error，默认 info
LOG_LEVEL=info
# text | json，默认 json
LOG_FORMAT=json
